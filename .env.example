# Public URL used by TileServer GL in generated TileJSON / viewer links.
# For production set this to the address clients actually use, with trailing slash.
PUBLIC_URL=http://localhost:8081/

# Host port for the Nginx web frontend.
WEB_PORT=8081

# Comma-separated host allow-list for TileServer GL URL generation.
# "*" disables the check; set your domain(s) in production.
ALLOWED_HOSTS=*

# Style editor API token (change before exposing /editor)
EDITOR_TOKEN=change-me
# uid/gid used by the editor container to write styles/ and style-versions/
EDITOR_UID=1000
EDITOR_GID=1000

# Optional OpenAI-compatible endpoint for the AI style assistant.
# Leave empty to use the local rule fallback.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Tile generation options (see Makefile).
REGION=shanghai
COASTLINE=osm
